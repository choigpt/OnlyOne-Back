{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "SSE Active Connections",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5000 },
              { "color": "red", "value": 6500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sse_connections_active", "legendFormat": "Active" }
      ]
    },
    {
      "title": "SSE Max Connections",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sse_connections_max", "legendFormat": "Max" }
      ]
    },
    {
      "title": "SSE Connection Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "rate(sse_connections_created_total[1m])", "legendFormat": "Created/s" },
        { "expr": "rate(sse_connections_closed_total[1m])", "legendFormat": "Closed/s" },
        { "expr": "rate(sse_connections_failed_total[1m])", "legendFormat": "Failed/s" }
      ]
    },
    {
      "title": "SSE Events Sent Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "rate(sse_events_sent_total{result=\"success\"}[1m])", "legendFormat": "Success/s" },
        { "expr": "rate(sse_events_sent_total{result=\"failure\"}[1m])", "legendFormat": "Failure/s" }
      ]
    },
    {
      "title": "SSE Connection Creation Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "rate(sse_connection_duration_seconds_sum[5m]) / rate(sse_connection_duration_seconds_count[5m])", "legendFormat": "Avg" },
        { "expr": "histogram_quantile(0.95, rate(sse_connection_duration_seconds_bucket[5m]))", "legendFormat": "P95" }
      ]
    },
    {
      "title": "SSE Stale Connections Cleaned",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "rate(sse_connections_stale_cleaned_total[5m])", "legendFormat": "Stale cleaned/s" }
      ]
    },
    {
      "title": "WebSocket Messages Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "rate(websocket_messages_total{type=\"received\"}[1m])", "legendFormat": "Received/s" },
        { "expr": "rate(websocket_messages_total{type=\"published\"}[1m])", "legendFormat": "Published/s" },
        { "expr": "rate(websocket_messages_total{type=\"error\"}[1m])", "legendFormat": "Error/s" }
      ]
    },
    {
      "title": "WebSocket Message Processing Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "rate(websocket_message_duration_seconds_sum[5m]) / rate(websocket_message_duration_seconds_count[5m])", "legendFormat": "Avg" },
        { "expr": "histogram_quantile(0.95, rate(websocket_message_duration_seconds_bucket[5m]))", "legendFormat": "P95" }
      ]
    },
    {
      "title": "STOMP Auth Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "rate(security_stomp_auth_total{result=\"success\"}[1m])", "legendFormat": "Success/s" },
        { "expr": "rate(security_stomp_auth_total{result=\"failure\"}[1m])", "legendFormat": "Failure/s" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["sse", "websocket", "realtime"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "SSE & WebSocket - OnlyOne",
  "uid": "sse-websocket-onlyone",
  "version": 1
}
