{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "MySQL Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "Connected"
        },
        {
          "expr": "mysql_global_status_threads_running",
          "legendFormat": "Running"
        },
        {
          "expr": "mysql_global_variables_max_connections",
          "legendFormat": "Max Allowed"
        }
      ]
    },
    {
      "title": "MySQL QPS (Queries Per Second)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries[1m])",
          "legendFormat": "QPS"
        },
        {
          "expr": "rate(mysql_global_status_commands_total{command=\"select\"}[1m])",
          "legendFormat": "SELECT/s"
        },
        {
          "expr": "rate(mysql_global_status_commands_total{command=\"insert\"}[1m])",
          "legendFormat": "INSERT/s"
        },
        {
          "expr": "rate(mysql_global_status_commands_total{command=\"update\"}[1m])",
          "legendFormat": "UPDATE/s"
        },
        {
          "expr": "rate(mysql_global_status_commands_total{command=\"delete\"}[1m])",
          "legendFormat": "DELETE/s"
        }
      ]
    },
    {
      "title": "Slow Queries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_slow_queries[1m])",
          "legendFormat": "Slow Queries/s"
        }
      ]
    },
    {
      "title": "InnoDB Buffer Pool Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - (rate(mysql_global_status_innodb_buffer_pool_reads[5m]) / (rate(mysql_global_status_innodb_buffer_pool_read_requests[5m]) + 1))",
          "legendFormat": "Hit Rate"
        }
      ]
    },
    {
      "title": "InnoDB Row Lock Waits",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_innodb_row_lock_waits[1m])",
          "legendFormat": "Row Lock Waits/s"
        },
        {
          "expr": "mysql_global_status_innodb_row_lock_current_waits",
          "legendFormat": "Current Row Lock Waits"
        }
      ]
    },
    {
      "title": "InnoDB Row Lock Wait Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_innodb_row_lock_time[1m])",
          "legendFormat": "Lock Time (ms/s)"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["mysql", "database"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "MySQL - OnlyOne",
  "uid": "mysql-onlyone",
  "version": 1
}
