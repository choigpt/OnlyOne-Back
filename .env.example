# Database
DB_PASSWORD=root
DB_PORT=3306

# Redis
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# AWS S3 (AWS SDK standard env var names)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=buddkit-image
AWS_CLOUDFRONT_DOMAIN=d1c3fg3ti7m8cn.cloudfront.net

# Kakao OAuth
KAKAO_CLIENT_ID=YOUR_KAKAO_CLIENT_ID
KAKAO_REDIRECT_URI=http://localhost:5173/kakao-callback

# JWT
JWT_SECRET=YOUR_JWT_SECRET_KEY_MIN_256_BITS
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Toss Payments
TOSS_CLIENT_KEY=YOUR_TOSS_CLIENT_KEY
TOSS_SECRET_API_KEY=YOUR_TOSS_SECRET_KEY
TOSS_SECURITY_KEY=YOUR_TOSS_SECURITY_KEY

# Application
APP_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=DEBUG
